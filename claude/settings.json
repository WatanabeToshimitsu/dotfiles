{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(tee:*)",
      "Bash(sort:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:docs.anthropic.com)",
      "Read(src/**)",
      "Edit(src/**)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(rm -f *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(wipe *)",
      "Bash(srm *)",
      "Bash(dd *)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(diskutil *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(chflags *)",
      "Bash(sudo *)",
      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git restore .*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d *)",
      "Bash(gh repo delete*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(npm uninstall -g *)",
      "Bash(npm rm -g *)",
      "Bash(yarn global *)",
      "Bash(pnpm add -g *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(pip3 install *)",
      "Bash(pip3 uninstall *)",
      "Bash(gem install *)",
      "Bash(gem uninstall *)",
      "Bash(cargo install *)",
      "Bash(go install *)",
      "Bash(curl -X POST *)",
      "Bash(curl -X PUT *)",
      "Bash(curl -X DELETE *)",
      "Bash(curl -X PATCH *)",
      "Bash(curl -d *)",
      "Bash(curl --data *)",
      "Bash(curl -F *)",
      "Bash(wget --post-data *)",
      "Bash(wget --post-file *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(nmap *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync --delete*)",
      "Bash(sftp *)",
      "Bash(socat *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(launchctl *)",
      "Bash(export PATH=*)",
      "Bash(unset *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(crontab *)",
      "Bash(at *)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm *)",
      "Bash(docker rm -f *)",
      "Bash(docker rmi *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",
      "Bash(docker-compose down -v*)",
      "Bash(docker compose down -v*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl drain *)",
      "Bash(aws ec2 terminate*)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 rb *)",
      "Bash(psql -c *DROP*)",
      "Bash(psql -c *TRUNCATE*)",
      "Bash(mysql -e *DROP*)",
      "Bash(mysql -e *TRUNCATE*)",
      "Bash(mongosh --eval *drop*)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(**/credentials/**)",
      "Read(**/credentials.*)",
      "Read(**/*.credentials)",
      "Read(**/secrets/**)",
      "Read(**/*.secrets)",
      "Read(**/.secrets/**)",
      "Read(**/*.token)",
      "Read(**/.production/**)",
      "Read(**/*.production.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Edit(**/*.env)",
      "Edit(**/*.env.*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(~/.npmrc)",
      "Edit(~/.netrc)",
      "Edit(**/.ssh/**)",
      "Edit(**/credentials/**)",
      "Edit(**/secrets/**)",
      "Edit(**/*.secrets)",
      "Edit(**/*.token)",
      "Edit(**/.production/**)",
      "Edit(**/*.production.*)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_rsa)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh api:*)",
      "Bash(git checkout:*)",
      "Bash(git config:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git switch:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {
    "difit": "user-invocable-only"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/post-ts-lint.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/compact-tool-output.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-bash.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-subagent-model.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/kz86n/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/link-worktree-memory.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest"
  },
  "enabledPlugins": {
    "co-mlops-context@hdl-agent-plugins": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "discernment-nudge@anthropic-agent-skills": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-powerline": {
      "source": {
        "source": "github",
        "repo": "Owloops/claude-powerline"
      },
      "autoUpdate": true
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    },
    "hdl-agent-plugins": {
      "source": {
        "source": "github",
        "repo": "hdwlab/hdl-agent-plugins"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "Japanese",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "teammateMode": "tmux",
  "inputNeededNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(agent-browser:*) for routine browser automation in a trusted workspace",
      "Bash(npx:*) for an existing project's configured toolchain; package installation still requires approval"
    ],
    "environment": [
      "Trust and repository scope must come from the current repository's own remote and project configuration; never reuse another repository's trust assumptions",
      "Treat credentials, personal data, confidential business data, and regulated data as sensitive; public paste and gist services are outside the trust boundary unless explicitly approved",
      "Treat remote targets or infrastructure whose name contains prod or production as sensitive"
    ]
  }
}
