{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "docker *",
      "docker-compose *",
      "gh *"
    ],
    "network": {
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": true,
      "strictAllowlist": false
    }
  },
  "requiredCredentialFiles": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gh/hosts.yml",
    "~/.claude/.credentials.json"
  ],
  "requiredCredentialEnvVars": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "GH_TOKEN",
    "AWS_SECRET_ACCESS_KEY"
  ],
  "permissionCases": [
    {
      "name": "read-only pull request inspection",
      "command": "gh pr view 42",
      "decision": "allow",
      "rule": "Bash(gh pr view:*)"
    },
    {
      "name": "arbitrary GitHub API request",
      "command": "gh api repos/example/project",
      "decision": "ask",
      "rule": "Bash(gh api:*)"
    },
    {
      "name": "sandbox escape",
      "command": "echo probe",
      "decision": "ask",
      "rule": "Bash(dangerouslyDisableSandbox:true)"
    },
    {
      "name": "destructive removal",
      "command": "rm -f artifact",
      "decision": "deny",
      "rule": "Bash(rm -f *)"
    },
    {
      "name": "secret file read",
      "command": "Read .env",
      "decision": "deny",
      "rule": "Read(**/*.env)"
    },
    {
      "name": "home npm credentials read",
      "command": "Read ~/.npmrc",
      "decision": "deny",
      "rule": "Read(~/.npmrc)"
    }
  ],
  "personalHookCases": [
    {
      "name": "specific git add",
      "toolName": "Bash",
      "command": "git add src/app.ts",
      "decision": "allow"
    },
    {
      "name": "git add all short option",
      "toolName": "Bash",
      "command": "git add -A",
      "decision": "deny"
    },
    {
      "name": "git add all long option",
      "toolName": "Bash",
      "command": "git add --all",
      "decision": "deny"
    },
    {
      "name": "git add working directory in a compound command",
      "toolName": "Bash",
      "command": "git add . && git status",
      "decision": "deny"
    },
    {
      "name": "non-Bash tool",
      "toolName": "Read",
      "command": "git add -A",
      "decision": "allow"
    }
  ]
}
