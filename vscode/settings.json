  "docker.containers.label": "Compose Project Name",
  "git.ignoreLegacyWarning": true,
  "editor.tabCompletion": "on",
  "editor.acceptSuggestionOnEnter": "smart",
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
  },
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
  },
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "editor.tabSize": 8,
  "redhat.telemetry.enabled": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "git.suggestSmartCommit": false,
  "shellformat.useEditorConfig": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "zsh",
      "args": ["--login", "-i", "-l"],
    },
  },
  "githubPullRequests.pullBranch": "never",
  "playwright.reuseBrowser": true,
  "settingsSync.ignoredSettings": ["CodeGPT.query.language"],
  "editor.inlineSuggest.enabled": true,
  "remote.SSH.connectTimeout": 60,
  "workbench.editor.tabActionCloseVisibility": false,
  "window.zoomLevel": 1,
  "security.workspace.trust.untrustedFiles": "open",
  // "json.format.keepLines": true,
  "remote.SSH.useLocalServer": false,
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],
  "terminal.integrated.scrollback": 10000,
  "ruff.trace.server": "messages",
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "makefile.configureOnOpen": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "application.shellEnvironmentResolutionTimeout": 30,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
  },
  "cline.modelSettings.o3Mini.reasoningEffort": "high",
  "cline.preferredLanguage": "Japanese - 日本語",
  "terminal.integrated.env.osx": {},
  "console-ninja.featureSet": "Community",
  "workbench.colorTheme": "Night Owl Light",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.chat.completionContext.typescript.mode": "sidecar",
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.fixes": true,
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "github.copilot.chat.search.keywordSuggestions": true,
  "containers.containers.label": "Compose Project Name",
  "github.copilot.chat.codesearch.enabled": true,
  "githubPullRequests.experimental.chat": true,
  "githubPullRequests.experimental.notificationsView": true,
  "githubPullRequests.experimental.useQuickChat": true,
  "python.analysis.addHoverSummaries": true,
  "python.analysis.aiCodeActions": {
    "convertFormatString": true,
    "convertLambdaToNamedFunction": true,
    "generateDocstring": true,
    "generateSymbol": true,
    "implementAbstractClasses": true,
  },
  "editor.experimental.preferTreeSitter.typescript": true,
  "typescript.preferGoToSourceDefinition": true,
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "docker.extension.enableComposeLanguageServer": false,
  "search.followSymlinks": false,
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "terminal.integrated.macOptionIsMeta": true,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.enableNewConversationShortcut": false,
  "claudeCode.initialPermissionMode": "plan",
  "claudeCode.useTerminal": true,
  "workbench.browser.openLocalhostLinks": false,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "yaml.disableSchemaDetection": [
