# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# --- herdr integration --------------------------------------------------
# Free cmd+1..9 from Ghostty tab switching so they reach herdr
# (workspace switching; unclaimed cmd keys pass through to the TUI).
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind

# cmd+k is clear_screen by default; free it for herdr pane navigation.
keybind = super+k=unbind

# cmd+h normally hides the window (macOS menu); send it to the terminal
# instead, encoded as kitty-keyboard super+h (nvim: previous buffer).
keybind = super+h=text:\x1b[104;9u

# --- VSCode-style cmd keybindings (dotfiles issue #32) -------------------
# herdr pane focus lives on cmd+shift+h/j/k/l (VSCode "navigate views");
# freed cmd+h/j/k/l reach nvim (buffer switch / completion menus).
# Unbind Ghostty defaults that collide; unclaimed cmd keys pass through.
# was scroll_to_selection:
keybind = super+j=unbind
# was write_screen_file:paste:
keybind = super+shift+j=unbind
# was end_search (use herdr prefix+e for scrollback search instead):
keybind = super+shift+f=unbind
# was navigate_search:previous (cmd+shift+g opens the herdr lazygit pane):
keybind = super+shift+g=unbind
# was undo (cmd+shift+t toggles the nvim terminal):
keybind = super+shift+t=unbind
# was close_window (also a macOS menu item, so forward as kitty CSI-u
# like super+h above); cmd+shift+w opens the herdr workspace/agent picker.
keybind = super+shift+w=text:\x1b[119;10u
# was select_all (terminal-level); forward to nvim as CSI-u for select-all.
# Terminal text can still be copied via herdr copy mode (prefix+[).
keybind = super+a=text:\x1b[97;9u

# --- cursor visibility ----------------------------------------------------
# The theme-default cursor is too faint; force high-contrast tokyonight
# orange and thicken bar cursors (nvim insert mode, shell prompts).
cursor-color = #ff9e64
cursor-text = #1a1b26
adjust-cursor-thickness = 2
